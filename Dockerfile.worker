FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends blender python3 python3-numpy \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 blender && useradd --uid 10001 --gid 10001 --no-create-home blender \
    && mkdir -p /opt/blender-chat/studio /run/blender && chown 10001:10001 /run/blender
WORKDIR /opt/blender-chat
COPY studio/__init__.py studio/errors.py studio/policy.py studio/protocol.py \
     studio/worker.py studio/blender_wrapper.py ./studio/
USER 10001:10001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp
ENTRYPOINT ["python3", "-m", "studio.worker"]
