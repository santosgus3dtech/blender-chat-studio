FROM python:3.12-slim
RUN groupadd --gid 10001 studio && useradd --uid 10001 --gid 10001 --no-create-home studio \
    && mkdir -p /exports && chown 10001:10001 /exports
WORKDIR /app
COPY pyproject.toml ./
COPY requirements.txt ./
RUN pip install --no-cache-dir --require-hashes -r requirements.txt
COPY studio/ ./studio/
COPY examples/*.py ./examples/
RUN pip install --no-cache-dir --no-deps .
USER 10001:10001
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/tmp BLENDER_OUTPUT_DIR=/exports
ENTRYPOINT ["blender-studio"]
